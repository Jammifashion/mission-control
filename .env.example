# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# API-Key zum Schutz aller Backend-Routen (außer /health und /api/health/full)
# Beliebiger sicherer Zufallswert, z.B.: openssl rand -hex 32
MC_API_KEY=

# Cloudflare Turnstile – Secret Key zur Bot-Verifikation des öffentlichen
# Chat-Endpunkts (POST /api/anfragen/chat, siehe frontend/anfrage.html)
# Cloudflare Dashboard → Turnstile → Widget → Secret Key
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Erlaubte Frontend-Origins für CORS (kommagetrennt für mehrere)
# Production: nur GitHub Pages; Development: localhost ergänzen
CORS_ORIGIN=https://jammifashion.github.io,http://localhost:5173

# ── WooCommerce (Default-Shop: JammiFashion) ─────────────────────────────────
# Shop-URL ohne abschließenden Slash
WC_URL=https://your-shop.de

# REST API Zugangsdaten – generieren unter: WooCommerce → Einstellungen → Erweitert → REST API
WC_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WooCommerce HonkShop (Sprint 5.4 – Multi-Shop, optional) ──────────────────
# Aktiv ab Frontend-Auswahl shop=honk. Wird shopConfig.js automatisch ausgelesen.
WC_URL_HONK=https://your-honkshop.de
WC_KEY_HONK=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_SECRET_HONK=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WordPress Media Upload (Varianten-Bilder, Basic Auth via Application Password)
# Username = Secret-Name (als Redakteur in WordPress angelegt), siehe shopConfig.js
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_APP_PASSWORD_HONK=xxxx xxxx xxxx xxxx xxxx xxxx

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Modell-IDs stehen NICHT hier, sondern im Sheet-Reiter "Config"
# (Business Sheet). Siehe CLAUDE.md, Abschnitt "Modell-Konfiguration".

# ── Google Cloud / Sheets ─────────────────────────────────────────────────────
# Google Sheets Spreadsheet-IDs
# SSOT (Single Source of Truth) – Produkte, Kategorien, Attribute
GOOGLE_SHEET_ID=your-spreadsheet-id

# Jammi Business Sheet (Kalkulation, Partner, Abrechnungen)
BUSINESS_SHEET_ID=1AbC...xyz

# GCP Projekt-ID (für Cloud Run / Secret Manager)
# Bewusst als Echtwert – kein Secret, dient als Kontrolle gegen falsch
# konfigurierte lokale Umgebungen.
GOOGLE_PROJECT_ID=mission-control-495711

# Google Auth – eine der beiden Optionen wählen:
#
# Option A (Lokale Entwicklung): Pfad zur Service-Account JSON-Datei
#   GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json
#
# Option B (Lokal oder CI): Service-Account JSON direkt als String (eine Zeile)
#   cat key.json | tr -d '\n'  → Inhalt hier einfügen
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"..."}

# ── Google Chat Benachrichtigungen ───────────────────────────────────────────
# Webhook-URL des Spaces, der bei neuen Kundenanfragen und Partnerbestellungen
# benachrichtigt wird. Google Chat → Space → Apps & Integrationen → Webhooks.
# Lokal nicht gebraucht: Platzhalter reicht, darf nur nicht leer sein
# (loadAllSecrets bricht bei leeren Werten ab). Alles ausser https:// zaehlt
# als "nicht konfiguriert", dann wird still nicht benachrichtigt.
GCHAT_WEBHOOK_URL=unused

# ── Notifications (ntfy.sh) ───────────────────────────────────────────────────
# Optional: Eindeutiger Topic-Name – unter https://ntfy.sh/<NTFY_TOPIC> abonnieren
# NTFY_TOPIC=mc-alerts-xyz

# ── Google Drive Backup ───────────────────────────────────────────────────────
GOOGLE_DRIVE_SHARED_DRIVE_ID=your-shared-drive-id
GOOGLE_DRIVE_BACKUP_DAILY_ID=your-daily-folder-id
GOOGLE_DRIVE_BACKUP_MONTHLY_ID=your-monthly-folder-id
